{
	"name": "Family Tree Builder",
	"short_name": "Family Tree",
	"description": "Sketch a family tree quickly from patchy information, mark how sure each fact is, and fill in researched detail later.",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"background_color": "#f4f2ee",
	"theme_color": "#2c6c5c",
	"icons": [
		{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
		{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
	]
}
