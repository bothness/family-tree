{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022"],
		"types": ["@cloudflare/workers-types"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true
	},
	"include": ["./**/*.ts", "../functions/**/*.ts"],
	"exclude": ["./**/*.test.ts"]
}
